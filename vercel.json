{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/generate-meme-image",
      "destination": "/api/generate-meme-image.js"
    },
    {
      "source": "/api/search-videos",
      "destination": "/api/search-videos.js"
    },
    {
      "source": "/api/health",
      "destination": "/api/health.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
